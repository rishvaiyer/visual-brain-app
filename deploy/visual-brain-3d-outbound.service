[Unit]
Description=Visual Brain private 3D outbound connector
After=network-online.target visual-brain-3d.service
Wants=network-online.target
Requires=visual-brain-3d.service

[Service]
Type=simple
WorkingDirectory=%h/apps/visual-brain-worker
LoadCredential=worker-token:%h/.config/visual-brain/worker-token
Environment=VISUAL_BRAIN_WORKER_PORT=18788
Environment=VISUAL_BRAIN_3D_WORKER_DIR=%h/apps/visual-brain-worker/.local-3d-worker
EnvironmentFile=%h/.config/visual-brain/worker.env
ExecStart=%h/apps/visual-brain-worker/.venv/bin/python %h/apps/visual-brain-worker/free_3d_outbound.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
